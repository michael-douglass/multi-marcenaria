# ── Frontend (Netlify + local) — prefixo VITE_ é obrigatório ──
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica-anon"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Na Netlify: Site configuration → Environment variables
# Use os mesmos nomes acima. Depois do deploy, configure no Supabase Auth:
# Site URL = https://seu-app.netlify.app

# ── Somente máquina local / scripts (NUNCA na Netlify) ──
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"

# ── Cortecloud / HelloMob (somente local — NUNCA na Netlify nem no git) ──
CORTECLOUD_EMAIL="seu-email@exemplo.com"
CORTECLOUD_PASSWORD="sua-senha"
HELLOMOB_START_URL="https://marceneiro.cortecloud.com.br/#/hellomobweb/22168837/view/environment/Quarto"
